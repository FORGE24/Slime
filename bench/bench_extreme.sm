// 极限性能测试：展示 Slime 对复杂算法的编译期优化
// - 小规模素数判定 (编译期算)
// - 小矩阵乘法 (编译期算)
// - 递归斐波那契 (编译期算)
// - 简单哈希暴力 (简化版，编译期穷举小空间)

const SMALL_PRIME = 997  // 小素数，编译期验证
const MATRIX_SIZE = 3    // 小矩阵

// =============================
// 1. 素数判定 (埃拉托斯特尼筛简化版)
// =============================

fn is_prime(n: int) -> bool
    if n <= 1
        return false
    end
    if n <= 3
        return true
    end
    if n % 2 == 0 || n % 3 == 0
        return false
    end
    var i = 5
    while i * i <= n
        if n % i == 0 || n % (i + 2) == 0
            return false
        end
        i = i + 6
    end
    return true
end

// 编译期调用小素数
var prime_result = is_prime(SMALL_PRIME)

