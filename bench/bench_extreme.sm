// =============================
// 3. 递归斐波那契 (小n)
// =============================

fn fib_recursive(n: int) -> int
    if n <= 1
        return n
    end
    return fib_recursive(n - 1) + fib_recursive(n - 2)
end

const FIB_N = 10  // 小n，编译期算
var fib_result = fib_recursive(FIB_N)

// =============================
// 4. 简单哈希暴力破解 (模拟，穷举小范围)
// =============================

// 简化：假设哈希是 x * 31 + y，目标 12345，穷举 x,y in 0..10
fn hash_brute(target: int) -> int
    var x = 0
    while x < 10
        var y = 0
        while y < 10
            if x * 31 + y == target
                return x * 100 + y  // 返回编码
            end
            y = y + 1
        end
        x = x + 1
    end
    return -1
end

const HASH_TARGET = 12345  // 假设匹配 x=396, y=5 (396*31 +5 =12345)
var hash_result = hash_brute(HASH_TARGET)

// =============================
// 主函数
// =============================

fn main
    call host.stdout "[compile-time] is_prime(997) = ", prime_result
    // call host.stdout "[compile-time] matrix_multiply result[0] = ", matrix_result[0]
    call host.stdout "[compile-time] fib_recursive(10) = ", fib_result
    call host.stdout "[compile-time] hash_brute(12345) = ", hash_result
end