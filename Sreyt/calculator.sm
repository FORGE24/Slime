// ============================================================
// Sreyt Calculator - 计算器应用
// ============================================================
// 使用 Sreyt GUI 库构建的简单计算器
// 支持基本的四则运算
// ============================================================

// ============================================================
// 计算器状态
// ============================================================

var calc_window = 0
var display_entry = 0

// 计算状态
var current_value = 0
var stored_value = 0
var current_operator = 0
var is_new_input = 1
var has_error = 0

// 操作符常量
let OP_NONE = 0
let OP_ADD = 1
let OP_SUB = 2
let OP_MUL = 3
let OP_DIV = 4

// ============================================================
// 显示更新
// ============================================================

fn update_display(value: int) {
    print "Calculator: Display =", value
}

fn show_error(msg: str) {
    has_error = 1
    print "Calculator Error:", msg
}

fn clear_error() {
    has_error = 0
}

// ============================================================
// 数字输入
// ============================================================

fn input_digit(digit: int) {
    if is_new_input == 1 {
        current_value = digit
        is_new_input = 0
    } else {
        current_value = current_value * 10 + digit
    }
    print "Calculator: Input digit", digit, "->", current_value
}

fn digit_0_click() {
    input_digit(0)
}

fn digit_1_click() {
    input_digit(1)
}

fn digit_2_click() {
    input_digit(2)
}

fn digit_3_click() {
    input_digit(3)
}

fn digit_4_click() {
    input_digit(4)
}

fn digit_5_click() {
    input_digit(5)
}

fn digit_6_click() {
    input_digit(6)
}

fn digit_7_click() {
    input_digit(7)
}

fn digit_8_click() {
    input_digit(8)
}

fn digit_9_click() {
    input_digit(9)
}

// ============================================================
// 操作符
// ============================================================

fn add_click() {
    perform_pending_operation()
    current_operator = OP_ADD
    stored_value = current_value
    is_new_input = 1
    print "Calculator: ADD, stored =", stored_value
}

fn sub_click() {
    perform_pending_operation()
    current_operator = OP_SUB
    stored_value = current_value
    is_new_input = 1
    print "Calculator: SUB, stored =", stored_value
}

fn mul_click() {
    perform_pending_operation()
    current_operator = OP_MUL
    stored_value = current_value
    is_new_input = 1
    print "Calculator: MUL, stored =", stored_value
}

fn div_click() {
    perform_pending_operation()
    current_operator = OP_DIV
    stored_value = current_value
    is_new_input = 1
    print "Calculator: DIV, stored =", stored_value
}

// ============================================================
// 计算逻辑
// ============================================================

fn perform_pending_operation() {
    if current_operator == OP_NONE {
        return
    }
    
    if has_error == 1 {
        return
    }
    
    var result = 0
    
    if current_operator == OP_ADD {
        result = stored_value + current_value
        print "Calculator:", stored_value, "+", current_value, "=", result
    }
    
    if current_operator == OP_SUB {
        result = stored_value - current_value
        print "Calculator:", stored_value, "-", current_value, "=", result
    }
    
    if current_operator == OP_MUL {
        result = stored_value * current_value
        print "Calculator:", stored_value, "*", current_value, "=", result
    }
    
    if current_operator == OP_DIV {
        if current_value == 0 {
            show_error("Division by zero")
            return
        }
        result = stored_value / current_value
        print "Calculator:", stored_value, "/", current_value, "=", result
    }
    
    current_value = result
    update_display(result)
}

fn equals_click() {
    perform_pending_operation()
    current_operator = OP_NONE
    is_new_input = 1
    print "Calculator: Result =", current_value
}

// ============================================================
// 功能按钮
// ============================================================

fn clear_click() {
    current_value = 0
    stored_value = 0
    current_operator = OP_NONE
    is_new_input = 1
    clear_error()
    update_display(0)
    print "Calculator: Cleared all"
}

fn clear_entry_click() {
    current_value = 0
    is_new_input = 1
    clear_error()
    update_display(0)
    print "Calculator: Cleared entry"
}

fn negate_click() {
    current_value = 0 - current_value
    update_display(current_value)
    print "Calculator: Negated ->", current_value
}

// ============================================================
// 主程序
// ============================================================

fn main {
    print "============================================"
    print "    Sreyt Calculator Application"
    print "============================================"
    print ""
    
    // 初始化计算器状态
    current_value = 0
    stored_value = 0
    current_operator = OP_NONE
    is_new_input = 1
    has_error = 0
    
    print "Calculator: Initialized"
    print ""
    
    // 模拟计算器操作演示
    print "--- Demo: Calculate 12 + 34 ---"
    
    // 输入 12
    digit_1_click()
    digit_2_click()
    
    // 按 +
    add_click()
    
    // 输入 34
    digit_3_click()
    digit_4_click()
    
    // 按 =
    equals_click()
    
    print ""
    print "--- Demo: Calculate 100 - 37 ---"
    
    // 清除
    clear_click()
    
    // 输入 100
    digit_1_click()
    digit_0_click()
    digit_0_click()
    
    // 按 -
    sub_click()
    
    // 输入 37
    digit_3_click()
    digit_7_click()
    
    // 按 =
    equals_click()
    
    print ""
    print "--- Demo: Calculate 6 * 7 ---"
    
    // 清除
    clear_click()
    
    // 输入 6
    digit_6_click()
    
    // 按 *
    mul_click()
    
    // 输入 7
    digit_7_click()
    
    // 按 =
    equals_click()
    
    print ""
    print "--- Demo: Calculate 144 / 12 ---"
    
    // 清除
    clear_click()
    
    // 输入 144
    digit_1_click()
    digit_4_click()
    digit_4_click()
    
    // 按 /
    div_click()
    
    // 输入 12
    digit_1_click()
    digit_2_click()
    
    // 按 =
    equals_click()
    
    print ""
    print "--- Demo: Division by zero ---"
    
    // 清除
    clear_click()
    
    // 输入 42
    digit_4_click()
    digit_2_click()
    
    // 按 /
    div_click()
    
    // 输入 0
    digit_0_click()
    
    // 按 =
    equals_click()
    
    print ""
    print "============================================"
    print "    Calculator Demo Complete"
    print "============================================"
}
