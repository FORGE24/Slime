// ============================================================
// Sreyt GUI Library - Main Library File
// ============================================================  
// Sreyt主文件：集成所有模块，提供统一的库接口
// 这是用户程序导入Sreyt时的主要入口点
// ============================================================

// ============================================================
// Sreyt库元信息
// ============================================================

let SREYT_VERSION = "1.0.0"
let SREYT_AUTHOR = "slime language project" 
let SREYT_DESCRIPTION = "GUI library following 'everything is interface' philosophy"

var sreyt_initialized = 0
var sreyt_debug_mode = 0

// ============================================================
// 核心模块加载
// ============================================================

// 注意：在实际实现中，这些应该是模块导入语句
// 现在用注释表示模块依赖关系

// import core.sm         // 核心系统和接口
// import widgets.sm      // 控件系统  
// import layout.sm       // 布局管理器
// import demo.sm         // 演示程序

call print "Loading Sreyt GUI Library v", SREYT_VERSION
call print "========================================"

// ============================================================
// 库初始化函数
// ============================================================

fn sreyt_init()
    if sreyt_initialized == 1
        call print "Sreyt: Already initialized, skipping"
        return 1
    end
    
    call print "Sreyt: Initializing GUI library..."
    
    // 初始化各个子系统
    call app_init
    call print "Sreyt: Core system initialized"
    
    // 注册默认事件处理器
    sreyt_initialized = 1
    
    call print "Sreyt: Library initialization complete"
    call print "Sreyt: Version ", SREYT_VERSION, " ready"
    
    return 1
end

fn sreyt_shutdown()
    if sreyt_initialized == 0
        call print "Sreyt: Not initialized, nothing to shutdown"
        return
    end
    
    call print "Sreyt: Shutting down GUI library..."
    
    call app_quit
    sreyt_initialized = 0
    
    call print "Sreyt: Shutdown complete"
end

fn sreyt_is_initialized()
    return sreyt_initialized
end

// ============================================================
// 调试和诊断功能
// ============================================================

fn sreyt_enable_debug()
    sreyt_debug_mode = 1
    call print "Sreyt: Debug mode enabled"
end

fn sreyt_disable_debug()
    sreyt_debug_mode = 0
    call print "Sreyt: Debug mode disabled"
end

fn sreyt_get_version()
    return SREYT_VERSION
end

fn sreyt_get_info()
    call print "Sreyt GUI Library Information:"
    call print "- Version: ", SREYT_VERSION
    call print "- Author: ", SREYT_AUTHOR
    call print "- Description: ", SREYT_DESCRIPTION
    call print "- Initialized: ", sreyt_initialized
    call print "- Debug mode: ", sreyt_debug_mode
end

fn sreyt_get_stats()
    call print "Sreyt System Statistics:"
    call windows_get_stats
    call widgets_list_active  
    call layouts_get_stats
end

// ============================================================
// 便捷API函数（高级接口）
// ============================================================

fn sreyt_create_app(title, width, height)
    call sreyt_init
    
    let main_window = call window_create, title, width, height
    call window_set_resizable, main_window, 1
    
    call print "Sreyt: Created application '", title, "' ", width, "x", height
    
    return main_window
end

fn sreyt_run_app(window_id)
    call window_show, window_id
    call print "Sreyt: Starting application main loop"
    
    // 简化的主循环
    var app_running = 1
    while app_running == 1
        call app_process_events
        
        // 检查窗口是否关闭
        if window_id == 0
            app_running = 0
        end
    end
    
    call print "Sreyt: Application main loop finished"
end

// ============================================================
// 快速创建常用控件组合
// ============================================================

fn sreyt_create_button_with_label(window_id, button_text, label_text, x, y)
    let button = call button_create, window_id, button_text, x, y, 80, 25
    let label = call label_create, window_id, label_text, x, y + 35
    
    call widget_show, button
    call widget_show, label
    
    call print "Sreyt: Created button+label combo at (", x, ",", y, ")"
    
    return button  // 返回按钮ID，标签作为附加
end

fn sreyt_create_input_form(window_id, label_text, x, y, width)
    let label = call label_create, window_id, label_text, x, y
    let entry = call entry_create, window_id, x, y + 25, width, 25
    
    call widget_show, label
    call widget_show, entry
    
    call print "Sreyt: Created input form '", label_text, "' at (", x, ",", y, ")"
    
    return entry  // 返回输入框ID
end

fn sreyt_create_dialog(title, message, width, height)
    let dialog_window = call window_create, title, width, height
    
    let message_label = call label_create, dialog_window, message, 20, 20
    let ok_button = call button_create, dialog_window, "OK", 
                    width / 2 - 30, height - 60, 60, 25
    
    call widget_show, message_label
    call widget_show, ok_button
    call window_show, dialog_window
    
    call print "Sreyt: Created dialog '", title, "'"
    
    return dialog_window
end

// ============================================================
// 主题和样式系统（基础版）
// ============================================================

let THEME_DEFAULT = 1
let THEME_DARK = 2
let THEME_LIGHT = 3

var current_theme = THEME_DEFAULT

fn sreyt_set_theme(theme_id)
    current_theme = theme_id
    
    if theme_id == THEME_DARK
        call print "Sreyt: Applied dark theme"
    else if theme_id == THEME_LIGHT
        call print "Sreyt: Applied light theme"
    else
        call print "Sreyt: Applied default theme"
    end
    
    // 在实际实现中，这里会更新所有窗口的外观
end

fn sreyt_get_theme()
    return current_theme
end

// ============================================================
// 库使用示例和教程
// ============================================================

fn sreyt_show_tutorial()
    call print "Sreyt GUI Library - Quick Tutorial"
    call print "=================================="
    call print "1. Initialize: sreyt_init()"
    call print "2. Create window: window_create(title, width, height)"
    call print "3. Add widgets: button_create(), label_create(), etc."
    call print "4. Set layout: grid_layout_create() or pack_layout_create()"
    call print "5. Show window: window_show(window_id)"
    call print "6. Run event loop: app_process_events()"
    call print "7. Cleanup: sreyt_shutdown()"
    call print ""
    call print "For complete examples, see demo.sm"
end

fn sreyt_run_hello_world()
    call print "Sreyt Hello World Example"
    call print "========================="
    
    call sreyt_init
    
    let window = call sreyt_create_app, "Hello Sreyt", 300, 150
    let hello_label = call label_create, window, "Hello, World from Sreyt!", 50, 50
    let quit_button = call button_create, window, "Quit", 100, 90, 60, 25
    
    call widget_show, hello_label
    call widget_show, quit_button
    
    call sreyt_run_app, window
    
    call print "Hello World demo finished"
end

// ============================================================
// 错误处理和验证
// ============================================================

fn sreyt_validate_system()
    call print "Sreyt: Validating system components..."
    
    let errors = 0
    
    if sreyt_initialized == 0
        call print "Error: Sreyt not initialized"
        errors = errors + 1
    end
    
    // 检查各个子系统
    let widget_count = call widgets_get_count
    let layout_count = call layouts_get_count
    
    call print "Sreyt: Active widgets: ", widget_count
    call print "Sreyt: Active layouts: ", layout_count
    
    if errors == 0
        call print "Sreyt: System validation passed"
        return 1
    else
        call print "Sreyt: System validation failed with ", errors, " errors"
        return 0
    end
end

// ============================================================
// 库加载完成
// ============================================================

call print "Sreyt GUI Library - Fully loaded"
call print "Available functions:"
call print "- sreyt_init() / sreyt_shutdown()"  
call print "- sreyt_create_app() / sreyt_run_app()"
call print "- sreyt_show_tutorial() / sreyt_run_hello_world()"
call print "- All core, widgets, and layout functions"
call print "Ready to build GUI applications with slime!"