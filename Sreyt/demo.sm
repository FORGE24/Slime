// ============================================================
// Sreyt GUI Library - Complete Example Application
// ============================================================
// 演示程序：展示Sreyt的核心功能
// 包含窗口、控件、布局、事件处理的完整示例
// ============================================================

// 导入Sreyt模块
// (在实际实现中，这些会是import语句)

// ============================================================
// 全局应用状态
// ============================================================

var main_window = 0
var button_counter = 0
var demo_running = 0

// ============================================================
// 回调函数定义
// ============================================================

fn button_click_handler()
    button_counter = button_counter + 1
    call print "Button clicked! Count:", button_counter
    
    if button_counter == 5
        call print "You've clicked 5 times! Resetting counter..."
        button_counter = 0
    end
end

fn window_close_handler()
    call print "Window closing - cleaning up..."
    demo_running = 0
    call app_quit
end

fn canvas_paint_demo(canvas_id)
    call print "Painting demo on canvas #", canvas_id
    
    // 绘制彩色矩形
    call canvas_draw_rect, canvas_id, 10, 10, 50, 30, 0xFF0000  // 红色
    call canvas_draw_rect, canvas_id, 70, 10, 50, 30, 0x00FF00  // 绿色
    call canvas_draw_rect, canvas_id, 130, 10, 50, 30, 0x0000FF // 蓝色
    
    // 绘制文本
    call canvas_draw_text, canvas_id, "Sreyt Graphics", 10, 50, 0x000000
    
    // 绘制线条
    call canvas_draw_line, canvas_id, 0, 80, 200, 80, 0x888888
    call canvas_draw_line, canvas_id, 0, 0, 200, 100, 0x444444
end

// ============================================================
// 主演示应用程序
// ============================================================

fn run_sreyt_demo()
    call print "Starting Sreyt GUI Demo Application"
    call print "========================================"
    
    demo_running = 1
    
    // 1. 创建主窗口
    main_window = call window_create, "Sreyt Demo - GUI Library Showcase", 800, 600
    call window_set_resizable, main_window, 1
    call on_window_close, main_window, window_close_handler
    
    call print "Created main window: ", main_window
    
    // 2. 创建Grid布局管理器
    let main_layout = call grid_layout_create, main_window, 4, 3
    
    // 3. 创建标题标签
    let title_label = call label_create, main_window, "Welcome to Sreyt GUI Library", 0, 0
    call label_set_color, title_label, 0x000080  // 深蓝色
    call grid_add_widget, main_layout, title_label, 0, 0, 1, 3  // 跨3列
    
    // 4. 创建按钮
    let demo_button = call button_create, main_window, "Click Me!", 0, 0, 100, 30
    call button_on_click, demo_button, button_click_handler
    call grid_add_widget, main_layout, demo_button, 1, 0, 1, 1
    
    // 5. 创建输入框
    let text_entry = call entry_create, main_window, 0, 0, 150, 25
    call entry_set_text, text_entry, "Type here..."
    call grid_add_widget, main_layout, text_entry, 1, 1, 1, 1
    
    // 6. 创建信息标签
    let info_label = call label_create, main_window, "Click count: 0", 0, 0
    call grid_add_widget, main_layout, info_label, 1, 2, 1, 1
    
    // 7. 创建画布控件
    let demo_canvas = call canvas_create, main_window, 0, 0, 250, 120
    call grid_add_widget, main_layout, demo_canvas, 2, 0, 2, 2
    call canvas_paint_demo, demo_canvas
    
    // 8. 创建侧边栏Frame
    let sidebar = call frame_create, main_window, 0, 0, 200, 120
    call grid_add_widget, main_layout, sidebar, 2, 2, 2, 1
    
    // 9. 在侧边栏中添加Pack布局
    let pack_layout = call pack_layout_create, sidebar, 0  // 垂直布局
    
    // 10. 添加侧边栏控件
    let settings_label = call label_create, sidebar, "Settings", 0, 0
    call pack_add_widget, pack_layout, settings_label, 5, ALIGN_CENTER
    
    let option1_button = call button_create, sidebar, "Option 1", 0, 0, 80, 25
    call pack_add_widget, pack_layout, option1_button, 3, ALIGN_LEFT
    
    let option2_button = call button_create, sidebar, "Option 2", 0, 0, 80, 25
    call pack_add_widget, pack_layout, option2_button, 3, ALIGN_LEFT
    
    // 11. 显示所有控件
    call widget_show, title_label
    call widget_show, demo_button
    call widget_show, text_entry
    call widget_show, info_label
    call widget_show, demo_canvas
    call widget_show, sidebar
    call widget_show, settings_label
    call widget_show, option1_button
    call widget_show, option2_button
    
    // 12. 显示窗口并开始事件循环
    call window_show, main_window
    call print "Demo window displayed - starting event loop"
    
    // 13. 模拟事件循环
    while demo_running == 1
        call app_process_events
        
        // 更新计数器显示（简化版）
        if button_counter != 0
            call label_set_text, info_label, "Click count: " 
            call print "Updated counter display"
        end
        
        // 模拟暂停
        call print "Event loop iteration..."
    end
    
    call print "Demo finished - cleaning up"
    call cleanup_demo
end

// ============================================================
// 清理函数
// ============================================================

fn cleanup_demo()
    call print "Cleaning up Sreyt Demo Application"
    
    // 销毁所有窗口和控件（Sreyt会自动清理）
    call window_destroy, main_window
    
    // 显示统计信息
    call windows_get_stats
    call widgets_list_active
    call layouts_get_stats
    
    call print "Sreyt Demo - Cleanup complete"
end

// ============================================================
// 演示小工具函数
// ============================================================

fn show_about_dialog()
    let about_window = call window_create, "About Sreyt", 400, 300
    
    let about_text = call label_create, about_window, "Sreyt GUI Library v1.0", 50, 50
    call label_set_color, about_text, 0x000080
    
    let info_text = call label_create, about_window, "Built with slime language", 50, 80
    let info_text2 = call label_create, about_window, "Everything is an interface", 50, 110
    
    let close_button = call button_create, about_window, "Close", 150, 200, 80, 30
    
    call widget_show, about_text
    call widget_show, info_text
    call widget_show, info_text2
    call widget_show, close_button
    
    call window_show, about_window
    
    call print "Displayed About dialog"
end

fn run_simple_demo()
    call print "Running Simple Sreyt Demo"
    call print "=========================="
    
    // 简化版演示
    let simple_window = call window_create, "Simple Demo", 400, 200
    
    let hello_label = call label_create, simple_window, "Hello, Sreyt!", 100, 50
    let test_button = call button_create, simple_window, "Test", 100, 100, 60, 25
    
    call widget_show, hello_label
    call widget_show, test_button
    call window_show, simple_window
    
    call print "Simple demo ready!"
end

// ============================================================
// 主程序入口
// ============================================================

fn main()
    call print "Sreyt GUI Library - Demo Application"
    call print "======================================"
    
    // 初始化Sreyt系统
    call app_init
    call print "Sreyt system initialized"
    
    // 运行主演示
    call run_sreyt_demo
    
    // 可选：运行其他演示
    // call run_simple_demo
    // call show_about_dialog
    
    call print "All demos completed"
end

call print "Sreyt Demo Application - Ready to run"
call print "Call main() to start the demonstration"