// ============================================================
// Sreyt GUI Library - Simple Test Application
// ============================================================
// 简单测试程序：验证Sreyt库的基本功能
// 这是一个最小化的GUI应用程序示例
// ============================================================

// ============================================================
// 测试应用程序
// ============================================================

fn run_sreyt_test()
    call print "Sreyt GUI Library - Test Application"
    call print "======================================"
    
    // 步骤1：初始化Sreyt系统
    call sreyt_init
    call print "✓ Sreyt system initialized"
    
    // 步骤2：创建主窗口
    let test_window = call window_create, "Sreyt Test", 400, 300
    call print "✓ Window created: ID=", test_window
    
    // 步骤3：测试基础控件
    call print "Testing basic widgets..."
    
    // 创建标题标签
    let title = call label_create, test_window, "Sreyt GUI Test", 120, 20
    call label_set_color, title, 0x000080  // 深蓝色
    call print "✓ Title label created: ID=", title
    
    // 创建测试按钮
    let test_btn = call button_create, test_window, "Test Button", 50, 60, 100, 30
    call print "✓ Test button created: ID=", test_btn
    
    // 创建输入框
    let input = call entry_create, test_window, 50, 100, 120, 25
    call entry_set_text, input, "Hello Sreyt"
    call print "✓ Text entry created: ID=", input
    
    // 创建信息标签
    let info = call label_create, test_window, "Status: Ready", 50, 140
    call print "✓ Info label created: ID=", info
    
    // 步骤4：测试画布控件
    call print "Testing canvas widget..."
    
    let canvas = call canvas_create, test_window, 200, 60, 150, 100
    call print "✓ Canvas created: ID=", canvas
    
    // 在画布上绘制测试图形
    call canvas_clear, canvas
    call canvas_draw_rect, canvas, 10, 10, 40, 30, 0xFF0000  // 红色矩形
    call canvas_draw_rect, canvas, 60, 10, 40, 30, 0x00FF00  // 绿色矩形
    call canvas_draw_text, canvas, "Sreyt", 10, 50, 0x000000  // 黑色文本
    call canvas_draw_line, canvas, 0, 80, 150, 80, 0x888888   // 灰色线
    call print "✓ Canvas graphics drawn"
    
    // 步骤5：测试布局管理器
    call print "Testing layout managers..."
    
    let layout = call place_layout_create, test_window
    call place_add_widget, layout, title, 120, 20, 160, 25
    call place_add_widget, layout, test_btn, 50, 60, 100, 30
    call place_add_widget, layout, input, 50, 100, 120, 25
    call place_add_widget, layout, info, 50, 140, 200, 25
    call place_add_widget, layout, canvas, 200, 60, 150, 100
    call print "✓ Place layout configured: ID=", layout
    
    // 步骤6：显示所有控件
    call print "Showing all widgets..."
    
    call widget_show, title
    call widget_show, test_btn
    call widget_show, input
    call widget_show, info
    call widget_show, canvas
    call print "✓ All widgets visible"
    
    // 步骤7：显示窗口
    call window_show, test_window
    call print "✓ Window displayed"
    
    // 步骤8：模拟用户交互
    call print "Simulating user interactions..."
    
    // 模拟按钮点击
    call print "- Simulating button click..."
    call label_set_text, info, "Status: Button clicked!"
    
    // 模拟文本输入
    call print "- Simulating text input..."
    call entry_set_text, input, "Test successful"
    
    // 更新画布
    call print "- Updating canvas..."
    call canvas_draw_rect, canvas, 110, 10, 30, 30, 0x0000FF  // 蓝色矩形
    call canvas_draw_text, canvas, "OK!", 110, 50, 0x008000    // 绿色文本
    
    call print "✓ Interactions simulated"
    
    // 步骤9：系统状态报告
    call print "System status report:"
    call widgets_list_active
    call layouts_get_stats
    call windows_get_stats
    
    call print "Test completed successfully!"
    return test_window
end

// ============================================================
// 控件功能测试
// ============================================================

fn test_widget_operations()
    call print "Testing widget operations..."
    
    let window = call window_create, "Widget Test", 300, 200
    
    // 测试控件创建和销毁
    let btn1 = call button_create, window, "Button 1", 10, 10, 80, 25
    let btn2 = call button_create, window, "Button 2", 10, 40, 80, 25
    
    call print "Created 2 buttons"
    call widgets_list_active
    
    // 测试控件显示/隐藏
    call widget_show, btn1
    call widget_hide, btn2
    call print "Button 1 shown, Button 2 hidden"
    
    // 测试控件移动和缩放
    call widget_move, btn1, 50, 50
    call widget_resize, btn1, 100, 35
    call print "Button 1 moved and resized"
    
    // 测试控件销毁
    call widget_destroy, btn2
    call print "Button 2 destroyed"
    call widgets_list_active
    
    call window_show, window
    return window
end

// ============================================================
// 布局系统测试  
// ============================================================

fn test_layout_systems()
    call print "Testing layout systems..."
    
    let window = call window_create, "Layout Test", 350, 250
    
    // 测试Grid布局
    call print "Testing Grid layout..."
    let grid = call grid_layout_create, window, 2, 2
    
    let btn_tl = call button_create, window, "TL", 0, 0, 50, 25
    let btn_tr = call button_create, window, "TR", 0, 0, 50, 25  
    let btn_bl = call button_create, window, "BL", 0, 0, 50, 25
    let btn_br = call button_create, window, "BR", 0, 0, 50, 25
    
    call grid_add_widget, grid, btn_tl, 0, 0, 1, 1
    call grid_add_widget, grid, btn_tr, 0, 1, 1, 1
    call grid_add_widget, grid, btn_bl, 1, 0, 1, 1
    call grid_add_widget, grid, btn_br, 1, 1, 1, 1
    
    call widget_show, btn_tl
    call widget_show, btn_tr
    call widget_show, btn_bl
    call widget_show, btn_br
    
    call print "Grid layout configured with 4 buttons"
    
    // 测试Pack布局
    call print "Testing Pack layout..."
    let pack = call pack_layout_create, window, 1  // 水平布局
    
    let pack_btn1 = call button_create, window, "P1", 0, 150, 40, 25
    let pack_btn2 = call button_create, window, "P2", 0, 150, 40, 25
    let pack_btn3 = call button_create, window, "P3", 0, 150, 40, 25
    
    call pack_add_widget, pack, pack_btn1, 5, ALIGN_LEFT
    call pack_add_widget, pack, pack_btn2, 5, ALIGN_LEFT  
    call pack_add_widget, pack, pack_btn3, 5, ALIGN_LEFT
    
    call widget_show, pack_btn1
    call widget_show, pack_btn2
    call widget_show, pack_btn3
    
    call print "Pack layout configured with 3 buttons"
    
    call window_show, window
    call layouts_get_stats
    
    return window
end

// ============================================================
// 主测试函数
// ============================================================

fn main_test()
    call print "Starting Sreyt GUI Library Tests"
    call print "================================="
    
    // 运行各项测试
    let test1 = call run_sreyt_test
    let test2 = call test_widget_operations  
    let test3 = call test_layout_systems
    
    call print ""
    call print "All tests completed successfully!"
    call print "Windows created:", test1, test2, test3
    
    // 最终状态报告
    call print ""
    call print "Final system state:"
    call sreyt_get_stats
    call sreyt_validate_system
end

// ============================================================
// 简单测试（最小版本）
// ============================================================

fn simple_test()
    call print "Sreyt Simple Test"
    call print "================="
    
    call sreyt_init
    let window = call sreyt_create_app, "Simple Test", 250, 150
    
    let label = call label_create, window, "Test OK", 80, 50
    call widget_show, label
    
    call window_show, window
    
    call print "Simple test complete - window displayed"
end

// ============================================================
// 入口点
// ============================================================

call print "Sreyt GUI Library Test Suite"
call print "============================"
call print "Available tests:"
call print "- main_test()     : Complete test suite"  
call print "- simple_test()   : Minimal test"
call print "- run_sreyt_test  : Main functionality test"
call print ""
call print "Ready to run tests!"