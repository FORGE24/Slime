// ============================================================
// Sreyt GUI Library - Layout Management System
// ============================================================
// 布局管理器：Grid, Pack, Place等布局策略
// 自动化的控件排列和窗口响应式设计
// ============================================================

// ============================================================
// 布局管理器接口定义
// ============================================================

def static.interface "Sreyt.Layout.Grid" any Out "host.layout"
def static.interface "Sreyt.Layout.Pack" any Out "host.layout"
def static.interface "Sreyt.Layout.Place" any Out "host.layout"
def static.interface "Sreyt.Layout.Update" any Out "host.layout"

// ============================================================
// 布局全局状态
// ============================================================

var layout_count = 0
var layouts_active = 0

// 布局类型常量
let LAYOUT_GRID = 1
let LAYOUT_PACK = 2
let LAYOUT_PLACE = 3

// 对齐常量
let ALIGN_LEFT = 1
let ALIGN_CENTER = 2
let ALIGN_RIGHT = 3
let ALIGN_TOP = 4  
let ALIGN_BOTTOM = 5

// ============================================================
// Grid布局管理器（网格布局）
// ============================================================

var grid_layouts = 0

fn grid_layout_create(parent_window, rows, cols)
    layout_count = layout_count + 1
    layouts_active = layouts_active + 1
    grid_layouts = grid_layouts + 1
    
    let layout_id = layout_count
    
    call Sreyt.Layout.Grid, layout_id, parent_window, rows, cols
    
    call print "Sreyt: Created Grid Layout #", layout_id
    call print "Sreyt: Grid size ", rows, "x", cols, " in window ", parent_window
    
    return layout_id
end

fn grid_add_widget(layout_id, widget_id, row, col, rowspan, colspan)
    call print "Sreyt: Adding widget #", widget_id, " to grid #", layout_id
    call print "Sreyt: Position (", row, ",", col, ") span ", rowspan, "x", colspan
    
    // 计算实际位置（简化版）
    let cell_width = 100
    let cell_height = 50
    let x = col * cell_width
    let y = row * cell_height
    let width = colspan * cell_width
    let height = rowspan * cell_height
    
    call widget_move, widget_id, x, y
    call widget_resize, widget_id, width, height
    
    call print "Sreyt: Grid cell calculated to (", x, ",", y, ") ", width, "x", height
end

// ============================================================
// Pack布局管理器（序列布局）
// ============================================================

var pack_layouts = 0
var pack_positions = 0

fn pack_layout_create(parent_window, direction)
    layout_count = layout_count + 1
    layouts_active = layouts_active + 1
    pack_layouts = pack_layouts + 1
    
    let layout_id = layout_count
    
    call Sreyt.Layout.Pack, layout_id, parent_window, direction
    
    call print "Sreyt: Created Pack Layout #", layout_id
    if direction == 1
        call print "Sreyt: Pack direction: horizontal"
    else
        call print "Sreyt: Pack direction: vertical"
    end
    
    return layout_id
end

fn pack_add_widget(layout_id, widget_id, padding, align)
    pack_positions = pack_positions + 1
    
    call print "Sreyt: Packing widget #", widget_id, " into layout #", layout_id
    call print "Sreyt: Padding=", padding, " align=", align, " position=", pack_positions
    
    // 简化的pack计算
    let x = pack_positions * 120 + padding
    let y = 10 + padding
    
    call widget_move, widget_id, x, y
    
    call print "Sreyt: Packed to position (", x, ",", y, ")"
end

// ============================================================
// Place布局管理器（绝对定位）
// ============================================================

var place_layouts = 0

fn place_layout_create(parent_window)
    layout_count = layout_count + 1
    layouts_active = layouts_active + 1
    place_layouts = place_layouts + 1
    
    let layout_id = layout_count
    
    call Sreyt.Layout.Place, layout_id, parent_window
    
    call print "Sreyt: Created Place Layout #", layout_id
    call print "Sreyt: Absolute positioning in window ", parent_window
    
    return layout_id
end

fn place_add_widget(layout_id, widget_id, x, y, width, height)
    call print "Sreyt: Placing widget #", widget_id, " in layout #", layout_id
    call print "Sreyt: Absolute position (", x, ",", y, ") size ", width, "x", height
    
    call widget_move, widget_id, x, y
    call widget_resize, widget_id, width, height
end

// ============================================================
// 布局响应式更新
// ============================================================

fn layout_update_all()
    call Sreyt.Layout.Update, 0
    call print "Sreyt: Updated all layouts"
end

fn layout_update(layout_id)
    call Sreyt.Layout.Update, layout_id
    call print "Sreyt: Updated layout #", layout_id
end

// ============================================================
// 布局约束系统
// ============================================================

fn layout_set_constraints(layout_id, min_width, min_height, max_width, max_height)
    call print "Sreyt: Setting constraints for layout #", layout_id
    call print "Sreyt: Min size ", min_width, "x", min_height
    call print "Sreyt: Max size ", max_width, "x", max_height
end

fn layout_set_padding(layout_id, left, top, right, bottom)
    call print "Sreyt: Setting padding for layout #", layout_id
    call print "Sreyt: Padding L:", left, " T:", top, " R:", right, " B:", bottom
end

fn layout_set_spacing(layout_id, horizontal, vertical)
    call print "Sreyt: Setting spacing for layout #", layout_id
    call print "Sreyt: Spacing H:", horizontal, " V:", vertical
end

// ============================================================
// 布局管理器销毁
// ============================================================

fn layout_destroy(layout_id)
    layouts_active = layouts_active - 1
    call print "Sreyt: Destroyed layout #", layout_id
    call print "Sreyt: Active layouts remaining: ", layouts_active
end

// ============================================================
// 布局系统查询
// ============================================================

fn layouts_get_count()
    return layouts_active
end

fn layouts_get_stats()
    call print "Sreyt Layout Statistics:"
    call print "- Total layouts: ", layout_count
    call print "- Active layouts: ", layouts_active
    call print "- Grid layouts: ", grid_layouts
    call print "- Pack layouts: ", pack_layouts  
    call print "- Place layouts: ", place_layouts
end

// ============================================================
// 高级布局功能
// ============================================================

fn layout_auto_size(layout_id)
    call print "Sreyt: Auto-sizing layout #", layout_id
    // 自动计算最佳布局尺寸
end

fn layout_distribute_space(layout_id, distribute_method)
    call print "Sreyt: Distributing space in layout #", layout_id
    call print "Sreyt: Method=", distribute_method
end

fn layout_align_widgets(layout_id, alignment)
    call print "Sreyt: Aligning widgets in layout #", layout_id
    call print "Sreyt: Alignment=", alignment
end

call print "Sreyt Layout Management System - Loaded successfully"
call print "Available layouts: Grid, Pack, Place"