// ============================================================
// Slime 标准库 - IO 模块 (io.sm)
// 提供输入输出功能
// ============================================================

// ============================================================
// 控制台 IO
// ============================================================

// 输出字符串到控制台
fn io_print(str: str) -> void
    // 简化实现：调用内置的 print 函数
    call print str
end

// 输出带换行符的字符串到控制台
fn io_println(str: str) -> void
    // 简化实现：调用内置的 print 函数
    call print str
end

// 从控制台读取一行输入
fn io_read_line() -> str
    // 简化实现：返回模拟输入
    return "Hello, World!"
end

// ============================================================
// 文件 IO
// ============================================================

// 打开文件
fn io_open_file(path: str, mode: str) -> any
    // 简化实现：返回一个数字作为文件句柄
    return 1
end

// 关闭文件
fn io_close_file(file: any) -> void
    // 简化实现：不做实际操作
end

// 读取文件内容
fn io_read_file(file: any) -> str
    // 简化实现：返回模拟文件内容
    return "File content"
end

// 写入文件内容
fn io_write_file(file: any, content: str) -> void
    // 简化实现：不做实际操作
end

// 追加文件内容
fn io_append_file(file: any, content: str) -> void
    // 简化实现：不做实际操作
end

// 获取文件大小
fn io_file_size(file: any) -> int
    // 简化实现：返回模拟文件大小
    return 1024
end

// 检查文件是否存在
fn io_file_exists(path: str) -> bool
    // 简化实现：返回 true
    return 1
end

// 删除文件
fn io_delete_file(path: str) -> void
    // 简化实现：不做实际操作
end

// 重命名文件
fn io_rename_file(old_path: str, new_path: str) -> void
    // 简化实现：不做实际操作
end

// ============================================================
// 目录操作
// ============================================================

// 创建目录
fn io_create_dir(path: str) -> void
    // 简化实现：不做实际操作
end

// 删除目录
fn io_delete_dir(path: str) -> void
    // 简化实现：不做实际操作
end

// 检查目录是否存在
fn io_dir_exists(path: str) -> bool
    // 简化实现：返回 true
    return 1
end

// 列出目录内容
fn io_list_dir(path: str) -> any
    // 简化实现：返回模拟目录内容
    return 1
end

// ============================================================
// IO 库初始化
// ============================================================

call print "Slime IO Library v1.0 loaded"
call print "Available functions:"
call print "  Console: io_print, io_println, io_read_line"
call print "  File: io_open_file, io_read_file, io_write_file"
call print "  Directory: io_create_dir, io_delete_dir, io_list_dir"
