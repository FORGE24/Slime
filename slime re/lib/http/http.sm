fn http_create_response(status_code: int, status_text: str) -> any
    // 简化实现：返回模拟响应
    return 1
end

// 设置响应头
fn http_response_set_header(response: any, name: str, value: str) -> void
    // 简化实现：不做实际操作
end

// 设置响应体
fn http_response_set_body(response: any, body: str) -> void
    // 简化实现：不做实际操作
end

// 设置 JSON 响应
fn http_response_json(response: any, data: any) -> void
    // 简化实现：不做实际操作
end

