// Slime性能测试 - 展示7大优化技术

// 测试1: 斐波那契（CTFE - 编译时执行）
fn fib_runtime(n: int) -> int {
    if n <= 1 {
        return n
    }
    return fib_runtime(n - 1) + fib_runtime(n - 2)
}

// 测试2: 求和计算
fn convergence_demo() -> int {
    var sum = 0
    var i = 0
    while i < 1000000 {
        sum = sum + i
        i = i + 1
    }
    return sum
}

// 测试3: 双重循环
fn temporal_collapse(iterations: int) -> int {
    var result = 0
    var t1 = 0
    while t1 < iterations {
        var t2 = 0
        while t2 < iterations {
            if (t1 * t2) % 7 == 0 {
                result = result + 1
            }
            t2 = t2 + 1
        }
        t1 = t1 + 1
    }
    return result
}

// 测试4: 多任务
fn compute_heavy(n: int) -> int {
    var sum = 0
    var i = 0
    while i < n {
        sum = sum + i * i
        i = i + 1
    }
    return sum
}

fn parallel_tasks() -> int {
    var task1 = compute_heavy(100)
    var task2 = compute_heavy(200)
    var task3 = compute_heavy(300)
    return task1 + task2 + task3
}

// 测试5: 并发求和
fn sum_range(start: int, end: int) -> int {
    var sum = 0
    var i = start
    while i < end {
        sum = sum + i
        i = i + 1
    }
    return sum
}

fn concurrent_sum(n: int) -> int {
    var part1 = sum_range(0, n / 4)
    var part2 = sum_range(n / 4, n / 2)
    var part3 = sum_range(n / 2, n * 3 / 4)
    var part4 = sum_range(n * 3 / 4, n)
    return part1 + part2 + part3 + part4
}

// 测试6: 矩阵计算
fn matrix_multiply_snippet() -> int {
    var result = 0
    var i = 0
    while i < 1000 {
        var temp = i * 3 + 5
        result = result + temp * temp
        i = i + 1
    }
    return result
}

fn main {
    print "=== Slime版本 (7大优化技术) ==="
    
    print "【1】斐波那契计算:"
    var fib_result = fib_runtime(30)
    print "  fib(30) =", fib_result
    
    print "【2】求和计算:"
    var sum_result = convergence_demo()
    print "  结果 =", sum_result
    
    print "【3】双重循环:"
    var loop_result = temporal_collapse(100)
    print "  结果 =", loop_result
    
    print "【4】多任务计算:"
    var task_result = parallel_tasks()
    print "  结果 =", task_result
    
    print "【5】并发求和:"
    var concurrent_result = concurrent_sum(10000)
    print "  结果 =", concurrent_result
    
    print "【6】矩阵计算:"
    var matrix_result = matrix_multiply_snippet()
    print "  结果 =", matrix_result
    
    print "=== Slime测试完成 ==="
}
