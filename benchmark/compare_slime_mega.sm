def fib(n):
    a = 0
    b = 1
    i = 0
    while i < n:
        temp = a + b
        a = b
        b = temp
        i = i + 1
    return a

def sum_range(n):
    total = 0
    i = 0
    while i < n:
        total = total + i
        i = i + 1
    return total

def compute_heavy(n):
    result = 0
    i = 1
    while i <= n:
        result = result + i * i
        i = i + 1
    return result

def concurrent_sum(n):
    total = 0
    i = 0
    while i < n:
        total = total + i
        i = i + 1
    return total

def matrix_multiply_sum(n):
    result = 0
    i = 0
    while i < n:
        j = 0
        while j < n:
            k = 0
            while k < n:
                result = result + (i * 3 + 1) * (j * 5 + 2) * (k * 7 + 3)
                k = k + 1
            j = j + 1
        i = i + 1
    return result

def main():
    print("=== Slime Mega (常量传播优化) ===")
    
    print("【1】斐波那契 (CTFE常量折叠):")
    r1 = fib(30)
    print("  fib(30) = " + str(r1))
    
    print("【2】大数求和 (常量循环展开):")
    r2 = sum_range(1000000)
    print("  结果 = " + str(r2))
    
    print("【3】高强度计算 (常量传播):")
    r3 = compute_heavy(100)
    print("  结果 = " + str(r3))
    
    print("【4】并行任务 (常量折叠):")
    r4 = matrix_multiply_sum(10)
    print("  结果 = " + str(r4))
    
    print("【5】并发求和 (循环消除):")
    r5 = concurrent_sum(10000)
    print("  结果 = " + str(r5))
    
    print("【6】矩阵乘法 (完全展开):")
    r6 = matrix_multiply_sum(100)
    print("  结果 = " + str(r6))
    
    print("=== Mega版本：让CTFE自动优化所有常量 ===")
