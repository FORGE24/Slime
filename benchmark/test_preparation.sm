// Slime Preparation Phase Demo
// 展示准备期的4大优化技术

fn small_add(x: int, y: int) -> int {
    return x + y
}

fn compute_result() -> int {
    var a = 10
    var b = 20
    var c = 30
    var sum = a + b + c
    var product = sum * 2
    return product
}

fn main() {
    print("=== Preparation Phase Demo ===")
    
    // 测试1: 常量折叠链
    var val1 = 100
    var val2 = 200
    var val3 = val1 + val2
    var val4 = val3 * 2
    var val5 = val4 - val1
    var val6 = val5 / 2
    
    print("Test 1 - Constant Folding Chain:")
    printint(val6)
    
    // 测试2: 嵌套计算
    var x = 5
    var y = 10
    var z = 15
    var result1 = x + y
    var result2 = result1 + z
    var result3 = result2 * 2
    var final_result = result3 - x
    
    print("Test 2 - Nested Computation:")
    printint(final_result)
    
    // 测试3: 复杂表达式
    var p = 7
    var q = 3
    var r = p * q + p - q
    var s = r * r
    
    print("Test 3 - Complex Expression:")
    printint(s)
    
    print("=== All computed at Preparation Time! ===")
}
