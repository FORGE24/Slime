// HTTP library for Slime

// HTTP request method
export enum Method {
    GET,
    POST,
    PUT,
    DELETE,
    PATCH,
    HEAD,
    OPTIONS,
}

// HTTP request structure
export struct Request {
    method: Method,
    url: str,
    headers: {str: str},
    body: str,
}

// HTTP response structure
export struct Response {
    status: u32,
    headers: {str: str},
    body: str,
}

// Send HTTP request
export fn request(req: Request) -> Response {
    // Implementation will be provided by compiler
    return Response {
        status: 200,
        headers: {},
        body: "",
    };
}

// Helper functions for common HTTP methods
export fn get(url: str) -> Response {
    return request(Request {
        method: Method::GET,
        url: url,
        headers: {},
        body: "",
    });
}

export fn post(url: str, body: str) -> Response {
    return request(Request {
        method: Method::POST,
        url: url,
        headers: {
            "Content-Type": "application/json",
        },
        body: body,
    });
}
