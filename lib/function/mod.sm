// Function library for Slime

// Function composition
export fn compose<A, B, C>(f: fn(B) -> C, g: fn(A) -> B) -> fn(A) -> C {
    return |x| f(g(x));
}

// Function application
export fn apply<A, B>(f: fn(A) -> B, x: A) -> B {
    return f(x);
}

// Currying
export fn curry<A, B, C>(f: fn(A, B) -> C) -> fn(A) -> fn(B) -> C {
    return |a| |b| f(a, b);
}

// Uncurrying
export fn uncurry<A, B, C>(f: fn(A) -> fn(B) -> C) -> fn(A, B) -> C {
    return |a, b| f(a)(b);
}

// Identity function
export fn id<T>(x: T) -> T {
    return x;
}

// Constant function
export fn const_fn<T, U>(x: T) -> fn(U) -> T {
    return |_| x;
}

// Flip arguments
export fn flip<A, B, C>(f: fn(A, B) -> C) -> fn(B, A) -> C {
    return |b, a| f(a, b);
}

// Partial application
export fn partial<A, B, C>(f: fn(A, B) -> C, a: A) -> fn(B) -> C {
    return |b| f(a, b);
}
