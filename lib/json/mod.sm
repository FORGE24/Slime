// JSON library for Slime

// JSON value type
export enum JsonValue {
    Null,
    Bool(bool),
    Number(f64),
    String(str),
    Array([JsonValue]),
    Object({str: JsonValue}),
}

// Parse JSON string to JsonValue
export fn parse(json: str) -> JsonValue {
    // Implementation will be provided by compiler
    return JsonValue::Null;
}

// Convert JsonValue to JSON string
export fn stringify(value: JsonValue) -> str {
    // Implementation will be provided by compiler
    return "";
}

// Helper functions
export fn from_number(num: f64) -> JsonValue {
    return JsonValue::Number(num);
}

export fn from_string(s: str) -> JsonValue {
    return JsonValue::String(s);
}

export fn from_bool(b: bool) -> JsonValue {
    return JsonValue::Bool(b);
}

export fn from_array(arr: [JsonValue]) -> JsonValue {
    return JsonValue::Array(arr);
}

export fn from_object(obj: {str: JsonValue}) -> JsonValue {
    return JsonValue::Object(obj);
}
