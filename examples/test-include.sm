// ============================================
// test-include.sm - include 文本包含测试
// 演示 C 风格的头文件包含
// ============================================

// 包含公共头文件
include "common.smh"

fn main {
    print "===== Include 测试 ====="
    
    // 使用头文件中定义的常量
    print "MAX_SIZE =", MAX_SIZE
    print "MIN_SIZE =", MIN_SIZE
    print "DEFAULT_VALUE =", DEFAULT_VALUE
    
    // 使用头文件中定义的接口
    call debug_print "这是通过 debug_print 接口输出的"
    
    print "===== 测试完成 ====="
}
