// ============================================
// strlib.sm - 字符串工具库模块
// ============================================

// 公开接口定义
def static.interface "str_print" str Out "host.stdout"

// 公开函数: 打印分隔线
pub fn print_line {
    call str_print "================================"
}

// 公开函数: 打印标题
pub fn print_title(title: str) {
    print_line()
    print title
    print_line()
}

// 公开函数: 打印带编号的项
pub fn print_item(num: int, text: str) {
    print num, ".", text
}
