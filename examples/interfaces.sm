// ============================================
// slime - 万物皆接口 (Everything is an Interface)
// ============================================
// 核心理念：所有操作都是接口调用
// 接口是 slime 的一等公民

// ========== 接口定义 ==========
// def 语法：def <类型>.<修饰符> "接口名" <数据类型> <方向> "目标接口"

// 定义一个简单输出接口，映射到系统输出
def static.interface "print" str Out "host.stdout"

// 定义一个带数据类型的输出接口
def static.interface "log" any Out "host.stdout"

// ========== 使用接口 ==========
// call 语法：call <接口名> <参数...>

// 使用自定义接口
call print "Hello, 这是通过 print 接口输出的"
call log "这是通过 log 接口输出的"

// 直接使用内置接口
call host.stdout "这是直接调用 host.stdout"

// ========== 变量与接口结合 ==========
let x = 10
let y = 20
let sum = x + y

// 输出变量（自动将数字转为字符串）
call log x
call log y
call log sum

// 多参数调用
call log "x + y =" sum

// ========== 条件与接口 ==========
if sum > 25
    call log "sum 大于 25"
else
    call log "sum 不大于 25"
end

// ========== 循环与接口 ==========
var i = 0
while i < 3
    call log i
    i = i + 1
end

// ========== 释放接口资源 ==========
// drop 语法：drop <接口名>
drop print
drop log
