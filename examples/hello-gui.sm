// =================================================================
// Slime GUI Hello World - 简单的 Win32 GUI 测试
// =================================================================
// 编译: slimec hello-gui.sm -o hello.asm --target windows
// 链接: nasm -fwin64 hello.asm -o hello.obj
//       link hello.obj /subsystem:windows /entry:Start kernel32.lib user32.lib gdi32.lib
// =================================================================

// 创建主窗口
window_create("Hello Slime GUI!", 400, 300)

// 创建标签
label_create(0, "Welcome to Slime Lang!", 50, 50, 300, 30)
label_create(0, "This is a real Win32 GUI window.", 50, 90, 300, 30)

// 创建一个按钮
button_create(0, "Click Me!", 150, 150, 100, 40)

// 创建一个输入框
entry_create(0, 50, 200, 300, 25)
