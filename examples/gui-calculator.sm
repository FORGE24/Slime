// =================================================================
// Slime GUI Calculator - 使用真正的 Win32 GUI
// =================================================================
// 这是一个使用 Sreyt GUI 后端的计算器应用
// 编译: slimec gui-calculator.sm -o calc.asm --target windows
// 链接: nasm -fwin64 calc.asm -o calc.obj
//       link calc.obj /subsystem:windows /entry:Start kernel32.lib user32.lib
// =================================================================

// 全局变量 - 存储计算状态
var current_value = 0
var stored_value = 0
var operation = 0      // 0=none, 1=add, 2=sub, 3=mul, 4=div
var new_number = 1     // 是否开始输入新数字 (1=true, 0=false)

// GUI 控件 ID
var display_id = 0
var btn_0 = 0
var btn_1 = 0
var btn_2 = 0
var btn_3 = 0
var btn_4 = 0
var btn_5 = 0
var btn_6 = 0
var btn_7 = 0
var btn_8 = 0
var btn_9 = 0
var btn_add = 0
var btn_sub = 0
var btn_mul = 0
var btn_div = 0
var btn_eq = 0
var btn_clear = 0

// 创建主窗口
window_create("Slime Calculator", 300, 400)

// 创建显示区域
display_id = label_create(0, "0", 10, 10, 270, 50)

// 创建数字按钮 - 第一行 7 8 9 /
btn_7 = button_create(0, "7", 10, 70, 60, 50)
btn_8 = button_create(0, "8", 80, 70, 60, 50)
btn_9 = button_create(0, "9", 150, 70, 60, 50)
btn_div = button_create(0, "/", 220, 70, 60, 50)

// 第二行 4 5 6 *
btn_4 = button_create(0, "4", 10, 130, 60, 50)
btn_5 = button_create(0, "5", 80, 130, 60, 50)
btn_6 = button_create(0, "6", 150, 130, 60, 50)
btn_mul = button_create(0, "*", 220, 130, 60, 50)

// 第三行 1 2 3 -
btn_1 = button_create(0, "1", 10, 190, 60, 50)
btn_2 = button_create(0, "2", 80, 190, 60, 50)
btn_3 = button_create(0, "3", 150, 190, 60, 50)
btn_sub = button_create(0, "-", 220, 190, 60, 50)

// 第四行 C 0 = +
btn_clear = button_create(0, "C", 10, 250, 60, 50)
btn_0 = button_create(0, "0", 80, 250, 60, 50)
btn_eq = button_create(0, "=", 150, 250, 60, 50)
btn_add = button_create(0, "+", 220, 250, 60, 50)

// 注册按钮回调
gui_on_click(btn_0, on_digit_0)
gui_on_click(btn_1, on_digit_1)
gui_on_click(btn_2, on_digit_2)
gui_on_click(btn_3, on_digit_3)
gui_on_click(btn_4, on_digit_4)
gui_on_click(btn_5, on_digit_5)
gui_on_click(btn_6, on_digit_6)
gui_on_click(btn_7, on_digit_7)
gui_on_click(btn_8, on_digit_8)
gui_on_click(btn_9, on_digit_9)
gui_on_click(btn_add, on_add)
gui_on_click(btn_sub, on_sub)
gui_on_click(btn_mul, on_mul)
gui_on_click(btn_div, on_div)
gui_on_click(btn_eq, on_equals)
gui_on_click(btn_clear, on_clear)

// 数字按钮回调函数
fn on_digit_0() {
    append_digit(0)
}

fn on_digit_1() {
    append_digit(1)
}

fn on_digit_2() {
    append_digit(2)
}

fn on_digit_3() {
    append_digit(3)
}

fn on_digit_4() {
    append_digit(4)
}

fn on_digit_5() {
    append_digit(5)
}

fn on_digit_6() {
    append_digit(6)
}

fn on_digit_7() {
    append_digit(7)
}

fn on_digit_8() {
    append_digit(8)
}

fn on_digit_9() {
    append_digit(9)
}

// 追加数字到当前值
fn append_digit(digit: int) {
    if new_number == 1 {
        current_value = digit
        new_number = 0
    } else {
        current_value = current_value * 10 + digit
    }
    update_display()
}

// 运算符回调
fn on_add() {
    do_operation()
    operation = 1
    stored_value = current_value
    new_number = 1
}

fn on_sub() {
    do_operation()
    operation = 2
    stored_value = current_value
    new_number = 1
}

fn on_mul() {
    do_operation()
    operation = 3
    stored_value = current_value
    new_number = 1
}

fn on_div() {
    do_operation()
    operation = 4
    stored_value = current_value
    new_number = 1
}

fn on_equals() {
    do_operation()
    operation = 0
    new_number = 1
}

fn on_clear() {
    current_value = 0
    stored_value = 0
    operation = 0
    new_number = 1
    update_display()
}

// 执行当前操作
fn do_operation() {
    if operation == 1 {
        current_value = stored_value + current_value
    } elif operation == 2 {
        current_value = stored_value - current_value
    } elif operation == 3 {
        current_value = stored_value * current_value
    } elif operation == 4 {
        if current_value != 0 {
            current_value = stored_value / current_value
        }
    }
    update_display()
}

// 更新显示
fn update_display() {
    // 将 current_value 转换为字符串并设置到显示区域
    gui_set_text(display_id, int_to_str(current_value))
}

// 整数转字符串（简化版）
fn int_to_str(n: int) -> str {
    // 这会由编译器内置函数处理
    return n
}
