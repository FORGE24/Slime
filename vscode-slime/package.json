{
  "name": "vscode-slime",
  "displayName": "Slime Language Support",
  "description": "VS Code support for Slime programming language",
  "version": "1.0.0",
  "publisher": "slime-lang",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Syntax"
  ],
  "contributes": {
    "languages": [
      {
        "id": "slime",
        "aliases": ["Slime", "slime"],
        "extensions": [".sm"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "slime",
        "scopeName": "source.slime",
        "path": "./syntaxes/slime.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "slime.build",
        "title": "Slime: Build"
      }
    ],
    "keybindings": [
      {
        "command": "slime.build",
        "key": "ctrl+shift+b",
        "when": "editorLangId == slime"
      }
    ],
    "tasks": [
      {
        "type": "slime",
        "label": "slime: build",
        "command": "slime",
        "args": ["build", "${file}"],
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "problemMatcher": [
          {
            "owner": "slime",
            "pattern": [
              {
                "regexp": "^(.*):(\\d+):(\\d+):\\s*([^:]+):\\s*(.*)$",
                "file": 1,
                "line": 2,
                "column": 3,
                "severity": 4,
                "message": 5
              }
            ]
          }
        ]
      }
    ]
  },
  "activationEvents": [
    "onLanguage:slime",
    "onCommand:slime.build"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.60.0",
    "@types/node": "^16.0.0",
    "typescript": "^4.3.5",
    "ts-node": "^10.0.0"
  }
}