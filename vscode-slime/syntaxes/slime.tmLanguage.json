{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Slime",
  "scopeName": "source.slime",
  "patterns": [
    {
      "include": "#statements"
    }
  ],
  "repository": {
    "statements": {
      "patterns": [
        {
          "include": "#function"
        },
        {
          "include": "#variable"
        },
        {
          "include": "#keyword"
        },
        {
          "include": "#string"
        },
        {
          "include": "#number"
        },
        {
          "include": "#comment"
        }
      ]
    },
    "function": {
      "patterns": [
        {
          "name": "meta.function.slime",
          "begin": "fn\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
          "beginCaptures": {
            "1": {
              "name": "entity.name.function.slime"
            }
          },
          "end": "\\)\\s*\\{"
        }
      ]
    },
    "variable": {
      "patterns": [
        {
          "name": "variable.other.slime",
          "match": "[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "keyword": {
      "patterns": [
        {
          "name": "keyword.control.slime",
          "match": "\\b(fn|let|if|else|return|while|for|break|continue|import|export)\\b"
        }
      ]
    },
    "string": {
      "patterns": [
        {
          "name": "string.quoted.double.slime",
          "begin": "\"",
          "end": "\"",
          "escapes": [
            {
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "number": {
      "patterns": [
        {
          "name": "constant.numeric.slime",
          "match": "\\b\\d+(\\.\\d+)?\\b"
        }
      ]
    },
    "comment": {
      "patterns": [
        {
          "name": "comment.line.double-slash.slime",
          "match": "//.*$"
        }
      ]
    }
  }
}